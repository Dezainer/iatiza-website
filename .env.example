# Contact form -> Google Sheets (see lib/sheets.ts)
# Service account credentials; share the spreadsheet with CLIENT_EMAIL as editor.
GOOGLE_SHEETS_CLIENT_EMAIL=
GOOGLE_SHEETS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEETS_SPREADSHEET_ID=
# Optional, defaults to the first tab. Columns: date, email, headcount, revenue
GOOGLE_SHEETS_RANGE=
